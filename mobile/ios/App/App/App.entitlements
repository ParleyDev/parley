<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Lets the app use passkeys and security keys for app.runparley.com in its web view; the server lists the app
	     in /.well-known/apple-app-site-association (IOS_APP_IDS). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:app.runparley.com</string>
	</array>
</dict>
</plist>
