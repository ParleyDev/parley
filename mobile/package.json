{
  "name": "parley-mobile",
  "private": true,
  "version": "1.0.0",
  "license": "Apache-2.0",
  "description": "Native iOS and Android shells for Parley: a connect-to-server screen, then the server's web client inside a native WebView with push, keep-awake, haptics and hardware back support.",
  "scripts": {
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "build:android": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "*",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "typescript": "^7.0.2"
  }
}
