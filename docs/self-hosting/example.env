# Copy to `.env` next to compose.yaml and fill in. Lines starting with # are ignored.

# --- Required -------------------------------------------------------------------------------------
# Random strings. Generate each with:  openssl rand -hex 32
# (no openssl? docker run --rm alpine/openssl rand -hex 32). Hex keeps them URL-safe.
POSTGRES_PASSWORD=
JWT_SECRET=

# The address people type to reach Parley. Used in emailed links and invites.
#   LAN only:        https://192.168.1.50:3443   (or https://parley.lan:3443)
#   Public / proxy:  https://chat.example.com
APP_URL=http://localhost:3000

# Accounts with these emails become Parley admins (Admin Console). Register with one of them first.
ADMIN_EMAILS=you@example.com

# --- Common options -------------------------------------------------------------------------------
# Image version: latest, a release tag such as v0.2.0, or sha-<commit>. Pin a release for predictable upgrades.
PARLEY_IMAGE_TAG=latest

# Where the database, uploads and certificates are stored on the host.
DATA_DIR=./data

# Host ports. Prefix with an address to restrict, e.g. 127.0.0.1:3000 when a reverse proxy runs on this host.
WEB_PORT=3000
WEB_TLS_PORT=3443

# Name in the self-signed certificate (and the Let's Encrypt domain). Use your hostname or LAN IP.
TLS_HOSTNAME=localhost

# Email. `log` prints mails to `docker compose logs backend`; `smtp` sends them; `off` disables.
MAIL_MODE=log
# SMTP_URL=smtp://user:password@smtp.example.com:587?tls=required
# MAIL_FROM=Parley <parley@example.com>

# GIF picker (optional): a Tenor key (preferred) or a Giphy key.
# TENOR_API_KEY=
# GIPHY_API_KEY=

# Voice/video behind strict NATs needs a TURN server (JSON array of RTCIceServer objects).
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]

# Per-user upload quota in bytes (0 = unlimited). Default 1 GiB.
# UPLOAD_QUOTA_BYTES=1073741824

# --- Profiles -------------------------------------------------------------------------------------
# Cloudflare Tunnel (docker compose --profile tunnel up -d)
# TUNNEL_TOKEN=

# Let's Encrypt (docker compose --profile letsencrypt up -d); also set TLS_HOSTNAME and WEB_PORT=80.
# LETSENCRYPT_EMAIL=you@example.com
# LETSENCRYPT_STAGING=0
