#!/usr/bin/env sh
# Identity guard: reject person/agent trailers and foreign identities in commit messages.
"$(git rev-parse --show-toplevel)/scripts/identity-guard.sh" commit-msg "$1" || exit 1
# Conventional Commits subject (scripts/version.mjs reads the types to pick the next release).
"$(git rev-parse --show-toplevel)/scripts/commit-lint.sh" "$1" || exit 1
# User guide: feat/fix/perf commits that change what docs/guide describes must update it (scripts/guide-check.mjs).
node "$(git rev-parse --show-toplevel)/scripts/guide-check.mjs" "$1" || exit 1
# What's New: a release commit must come with a changelog entry (scripts/changelog-check.mjs).
node "$(git rev-parse --show-toplevel)/scripts/changelog-check.mjs" "$1" || exit 1
